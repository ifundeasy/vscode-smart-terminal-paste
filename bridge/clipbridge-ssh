#!/bin/sh
# clipbridge: clipbridge-ssh <request> [args...]
# Sends one clipboard request (ping | targets SEL | get SEL TYPE | set SEL) to your
# machine over SSH, using the dedicated clipbridge key. On your machine that key is
# locked to clipbridge-serve, which validates the request; nothing else can run.
# stdin/stdout pass straight through.
# Config: ~/.config/clipbridge/config (see bridge/config.example)
CONF="${CLIPBRIDGE_CONFIG:-$HOME/.config/clipbridge/config}"
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
[ -n "${CLIPBRIDGE_HOST:-}" ] || { echo "clipbridge: CLIPBRIDGE_HOST not set in $CONF" >&2; exit 1; }
KEY="${CLIPBRIDGE_KEY:-$HOME/.ssh/clipbridge_ed25519}"

exec ssh -i "$KEY" -o IdentitiesOnly=yes -o BatchMode=yes \
  -o ConnectTimeout="${CLIPBRIDGE_CONNECT_TIMEOUT:-4}" \
  -o ControlMaster=auto -o ControlPath="$HOME/.ssh/cm-clipbridge-v2-%C" -o ControlPersist=600 \
  "$CLIPBRIDGE_HOST" "$*"
