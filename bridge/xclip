#!/bin/sh
# clipbridge: xclip shim
# When clip-route says you are on your machine (the client), clipboard reads (-o) come
# from and writes (stdin) go to your machine's clipboard through clipbridge-ssh.
# Everything else runs the real xclip unchanged: file arguments, the secondary
# selection, -version/-help, and every call made while you are at this host.
REAL=${CLIPBRIDGE_REAL_XCLIP:-/usr/bin/xclip}
BIN=$(dirname "$0")

sel=primary; target=""; is_read=0; has_file=0; passthru=0; want=""
for a in "$@"; do
  if [ -n "$want" ]; then
    case "$want" in sel) sel=$a ;; target) target=$a ;; esac
    want=""; continue
  fi
  case "$a" in
    -o|-out) is_read=1 ;;
    -selection|-sel) want=sel ;;
    -t|-target) want=target ;;
    -d|-display|-l|-loops) want=skip ;;
    -version|-h|-help) passthru=1 ;;
    -*) ;;
    *) has_file=1 ;;
  esac
done
case "$sel" in c*) sel=clipboard ;; p*) sel=primary ;; *) passthru=1 ;; esac

if [ "$passthru" = 0 ] && [ "$has_file" = 0 ] && "$BIN/clip-route"; then
  if [ "$is_read" = 1 ]; then
    case "$target" in
      TARGETS) exec "$BIN/clipbridge-ssh" targets "$sel" ;;
      "") exec "$BIN/clipbridge-ssh" get "$sel" UTF8_STRING ;;
      *) exec "$BIN/clipbridge-ssh" get "$sel" "$target" ;;
    esac
  fi
  exec "$BIN/clipbridge-ssh" set "$sel"
fi
exec "$REAL" "$@"
