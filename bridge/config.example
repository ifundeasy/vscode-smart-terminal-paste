# clipbridge config: copy to ~/.config/clipbridge/config on the SSH server.
# install.sh writes this file for you.

# SSH destination of YOUR machine (the client), as reachable from this server, e.g. a
# ~/.ssh/config alias or a Tailscale MagicDNS name. `ssh -o BatchMode=yes "$CLIPBRIDGE_HOST" true`
# must succeed without a prompt.
CLIPBRIDGE_HOST=my-laptop

# Source IP(s) of your machine's SSH connections, as this server sees them: the first
# field of $SSH_CONNECTION in a shell you opened from your machine. Space-separated.
CLIPBRIDGE_CLIENT_IPS="100.64.0.2"

# Rule 2 (sessions that carry this server's desktop environment): use your machine's
# clipboard only if this server's desktop has been idle longer than this (ms).
# Set CLIPBRIDGE_DESKTOP_RULE=0 to disable rule 2 entirely.
CLIPBRIDGE_IDLE_MS=4000
CLIPBRIDGE_DESKTOP_RULE=1

# Port this server's sshd listens on (used to detect your live connection).
CLIPBRIDGE_SSH_PORT=22

# Display names of the desktop session on YOUR machine.
CLIPBRIDGE_CLIENT_DISPLAY=:0
CLIPBRIDGE_CLIENT_WAYLAND_DISPLAY=wayland-0
